{
  "manifest_version": 3,
  "name": "Instagram File Support",
  "short_name": "IGFileShare",
  "version": "1.1.0",
  "description": "Share files in Instagram DMs via Filebin API. Upload files and let recipients download without leaving Instagram.",
  "author": "Aditya Pokuri",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://filebin.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Instagram File Support"
  }
}
